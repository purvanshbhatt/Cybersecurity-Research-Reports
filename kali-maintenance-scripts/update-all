#!/usr/bin/env bash
#═══════════════════════════════════════════════════════════════════════════════
#  update-all — Full System & App Updater
#
#  Updates: Kali apt packages, bun, ollama, rustup/rust, go, opencode,
#           npm global packages, docker, bun packages, pip packages
#
#  Usage:  sudo update-all              # Full update (needs sudo for apt)
#          update-all --no-apt          # Skip apt (no sudo needed)
#          update-all --dry-run         # Preview only
#
#  System: Kali 2026.3 | Created: 2026-10-31
#═══════════════════════════════════════════════════════════════════════════════
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'

DRY_RUN=false; SKIP_APT=false
for arg in "$@"; do
  case "$arg" in
    --dry-run|-n) DRY_RUN=true ;;
    --no-apt)     SKIP_APT=true ;;
  esac
done

log()    { echo -e "  ${GREEN}[✓]${NC} $*"; }
warn()   { echo -e "  ${YELLOW}[!]${NC} $*"; }
err()    { echo -e "  ${RED}[✗]${NC} $*"; }
info()   { echo -e "  ${CYAN}[i]${NC} $*"; }
header() { echo ""; echo -e "${BOLD}  ══ $* ══${NC}"; echo ""; }
run()    { if ! $DRY_RUN; then eval "$@"; else info "[dry-run] $*"; fi; }

ERRORS=()
track() { ERRORS+=("$1"); }

echo ""
echo -e "${BOLD}  ╔════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}  ║     🔄 update-all — Full System Updater   ║${NC}"
echo -e "${BOLD}  ╚════════════════════════════════════════════╝${NC}"
echo -e "  $(date '+%Y-%m-%d %H:%M:%S')  |  Kali $(grep VERSION_ID /etc/os-release | cut -d= -f2)"
echo ""

# ── 1. APT (Kali system packages) ───────────────────────────────────
if ! $SKIP_APT; then
  header "1/8 — APT: Kali System Packages"

  if [[ $EUID -ne 0 ]] && ! $DRY_RUN; then
    warn "Not running as root. Skipping apt. Use: sudo update-all"
    warn "Or run without apt:  update-all --no-apt"
    SKIP_APT=true
  else
    info "Updating package lists..."
    run "apt-get update -qq 2>&1 | tail -3" || track "apt update failed"

    # Show what will be upgraded
    UPGRADEABLE=$(apt list --upgradable 2>/dev/null | grep -v "^Listing" | wc -l)
    info "$UPGRADEABLE packages can be upgraded"
    apt list --upgradable 2>/dev/null | grep -v "^Listing" | awk -F/ '{print "    •", $1}' | head -20

    echo ""
    info "Running full upgrade (safe — no package removal)..."
    run "DEBIAN_FRONTEND=noninteractive apt-get full-upgrade -y \
        -o Dpkg::Options::='--force-confdef' \
        -o Dpkg::Options::='--force-confold' \
        2>&1 | tail -10" || track "apt full-upgrade failed"

    # Clean up
    run "apt-get autoremove -y -qq 2>&1 | tail -2" || true
    run "apt-get autoclean -qq" || true
    log "APT upgrade complete"
  fi
fi

# ── 2. bun ─────────────────────────────────────────────────────────
header "2/8 — Bun (JavaScript runtime)"

BUN_INSTALLED=$($HOME/.bun/bin/bun --version 2>/dev/null || echo "0.0.0")
info "Installed: $BUN_INSTALLED"

if ! $DRY_RUN; then
  BUN_LATEST=$(curl -sf https://api.github.com/repos/oven-sh/bun/releases/latest \
    | grep '"tag_name"' | cut -d'"' -f4 | sed 's/bun-v//')
  info "Latest:    $BUN_LATEST"
  if [[ "$BUN_INSTALLED" != "$BUN_LATEST" ]]; then
    info "Upgrading bun $BUN_INSTALLED → $BUN_LATEST..."
    $HOME/.bun/bin/bun upgrade 2>&1 | tail -3 && log "bun upgraded to $BUN_LATEST" || track "bun upgrade failed"
  else
    log "bun is up to date ($BUN_INSTALLED)"
  fi
else
  info "[dry-run] Would run: bun upgrade"
fi

# ── 3. Ollama ──────────────────────────────────────────────────────
header "3/8 — Ollama (local LLM runner)"

OLLAMA_INSTALLED=$(ollama --version 2>/dev/null | awk '{print $NF}')
info "Installed: $OLLAMA_INSTALLED"

if ! $DRY_RUN; then
  OLLAMA_LATEST=$(curl -sf https://api.github.com/repos/ollama/ollama/releases/latest \
    | grep '"tag_name"' | cut -d'"' -f4 | sed 's/v//')
  info "Latest:    $OLLAMA_LATEST"
  if [[ "$OLLAMA_INSTALLED" != "$OLLAMA_LATEST" ]]; then
    info "Upgrading ollama $OLLAMA_INSTALLED → $OLLAMA_LATEST..."
    curl -fsSL https://ollama.com/install.sh | sh 2>&1 | tail -5 \
      && log "ollama upgraded to $OLLAMA_LATEST" \
      || track "ollama upgrade failed"
  else
    log "ollama is up to date ($OLLAMA_INSTALLED)"
  fi
else
  info "[dry-run] Would reinstall ollama via install.sh"
fi

# ── 4. Rust / rustup ───────────────────────────────────────────────
header "4/8 — Rust (rustup)"

if command -v rustup &>/dev/null; then
  RUST_INSTALLED=$(rustc --version 2>/dev/null | awk '{print $2}')
  info "Installed: $RUST_INSTALLED"
  run "rustup update stable 2>&1 | tail -5" \
    && log "Rust updated" \
    || track "rustup update failed"
else
  warn "rustup not found. Rust may be system-installed (managed by apt)."
  log "Skipping (will be handled by apt)"
fi

# ── 5. Go ──────────────────────────────────────────────────────────
header "5/8 — Go"

if command -v go &>/dev/null; then
  GO_INSTALLED=$(go version 2>/dev/null | awk '{print $3}' | sed 's/go//')
  info "Installed: $GO_INSTALLED"

  if ! $DRY_RUN; then
    GO_LATEST=$(curl -sf https://go.dev/dl/?mode=json \
      | python3 -c "import sys,json; d=json.load(sys.stdin); print(d[0]['version'].replace('go',''))" 2>/dev/null)
    info "Latest:    $GO_LATEST"

    if [[ -n "$GO_LATEST" && "$GO_INSTALLED" != "$GO_LATEST" ]]; then
      info "Upgrading Go $GO_INSTALLED → $GO_LATEST..."
      cd /tmp
      curl -sfLO "https://go.dev/dl/go${GO_LATEST}.linux-amd64.tar.gz" \
        && sudo rm -rf /usr/local/go \
        && sudo tar -C /usr/local -xzf "go${GO_LATEST}.linux-amd64.tar.gz" \
        && rm -f "go${GO_LATEST}.linux-amd64.tar.gz" \
        && log "Go upgraded to $GO_LATEST" \
        || track "Go upgrade failed"
    else
      log "Go is up to date ($GO_INSTALLED)"
    fi
  else
    info "[dry-run] Would upgrade Go via tarball"
  fi
else
  warn "go not found in PATH"
fi

# ── 6. opencode ────────────────────────────────────────────────────
header "6/8 — opencode (AI coding CLI)"

if [[ -f "$HOME/.opencode/bin/opencode" ]]; then
  OC_INSTALLED=$($HOME/.opencode/bin/opencode --version 2>/dev/null | head -1)
  info "Installed: $OC_INSTALLED"
  if ! $DRY_RUN; then
    info "Checking for opencode update..."
    curl -fsSL https://opencode.ai/install | bash 2>&1 | tail -5 \
      && log "opencode updated" \
      || track "opencode update failed"
  else
    info "[dry-run] Would reinstall opencode via install script"
  fi
else
  warn "opencode not found at ~/.opencode/bin/opencode"
fi

# ── 7. npm global packages ─────────────────────────────────────────
header "7/8 — npm Global Packages"

if command -v npm &>/dev/null; then
  info "Outdated npm globals:"
  npm outdated -g --parseable 2>/dev/null | awk -F: '{print "    •", $4, "→", $3}' | head -15 || true

  run "npm update -g 2>&1 | tail -5" \
    && log "npm globals updated" \
    || track "npm global update failed"
else
  warn "npm not found"
fi

# ── 8. pip user packages ───────────────────────────────────────────
header "8/8 — pip User Packages"

if command -v pip3 &>/dev/null; then
  info "Checking outdated pip packages..."
  OUTDATED=$(pip3 list --outdated --user 2>/dev/null | tail -n +3 | awk '{print $1}')
  if [[ -n "$OUTDATED" ]]; then
    echo "$OUTDATED" | awk '{print "    •", $1}' | head -10
    COUNT=$(echo "$OUTDATED" | wc -l)
    info "$COUNT outdated user packages"
    if ! $DRY_RUN; then
      echo "$OUTDATED" | xargs -r pip3 install --upgrade --user 2>&1 | tail -5 \
        && log "pip packages updated" \
        || track "pip update had errors"
    else
      info "[dry-run] Would upgrade $COUNT pip packages"
    fi
  else
    log "All pip packages are up to date"
  fi
fi

# ── Summary ────────────────────────────────────────────────────────
echo ""
echo -e "${BOLD}  ══ FINAL SUMMARY ══${NC}"
echo ""

echo -e "  ${CYAN}App Versions After Update:${NC}"
for app in bun node npm python3 go rustc ollama git docker code; do
  ver=$(command -v $app &>/dev/null && $app --version 2>/dev/null | head -1 || echo "N/A")
  printf "    %-12s %s\n" "$app" "$ver"
done
OPENCODE_VER=$($HOME/.opencode/bin/opencode --version 2>/dev/null | head -1 || echo "N/A")
printf "    %-12s %s\n" "opencode" "$OPENCODE_VER"
echo ""

if [[ ${#ERRORS[@]} -eq 0 ]]; then
  log "All updates completed successfully"
else
  warn "${#ERRORS[@]} update(s) had issues:"
  for e in "${ERRORS[@]}"; do
    err "  $e"
  done
fi

echo ""
echo -e "  ${DIM}Run again anytime: sudo update-all${NC}"
echo ""
