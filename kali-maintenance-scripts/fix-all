#!/usr/bin/env bash
#═══════════════════════════════════════════════════════════════════════════════
#  fix-all — Complete System Recovery After Sleep/Crash + Permanent Fix
#
#  Fixes:  Hybrid sleep crash → segfaults → apps won't open → dpkg errors
#          → bun errors → RAM leaks
#
#  Usage:  sudo fix-all               # Full repair (interactive)
#          sudo fix-all --recover      # Quick recovery after crash
#          sudo fix-all --permanent    # Apply permanent sleep fix (once)
#          sudo fix-all --force        # No prompts
#          fix-all --dry-run           # Preview only
#
#  System: Kali 2026.3 | Kernel 7.1.5 | NVIDIA GTX 1050 + Intel UHD 620
#  Author: Antigravity Agent | Created: 2026-10-31
#═══════════════════════════════════════════════════════════════════════════════
set -euo pipefail

# ── Colors ───────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'

MODE="${1:-full}"
DRY_RUN=false; FORCE=false; RECOVER_ONLY=false; PERMANENT_ONLY=false
case "$MODE" in
  --force|-f)     FORCE=true ;;
  --dry-run|-n)   DRY_RUN=true ;;
  --recover|-r)   RECOVER_ONLY=true ;;
  --permanent|-p) PERMANENT_ONLY=true ;;
  *)              ;; # full
esac

log()    { echo -e "  ${GREEN}[✓]${NC} $*"; }
warn()   { echo -e "  ${YELLOW}[!]${NC} $*"; }
err()    { echo -e "  ${RED}[✗]${NC} $*"; }
info()   { echo -e "  ${CYAN}[i]${NC} $*"; }
header() { echo ""; echo -e "${BOLD}  ═══ $* ═══${NC}"; echo ""; }
hr()     { echo -e "${DIM}  ─────────────────────────────────────────────────────${NC}"; }

confirm() {
  if $FORCE || $DRY_RUN || [[ ! -t 0 ]]; then return 0; fi
  read -rp "    Proceed? [Y/n] " ans
  [[ -z "$ans" || "$ans" =~ ^[Yy] ]]
}

need_root() {
  if [[ $EUID -ne 0 ]] && ! $DRY_RUN; then
    err "This script must be run with sudo for system fixes."
    err "Usage: sudo fix-all"
    exit 1
  fi
}

# ── Banner ───────────────────────────────────────────────────────────
echo ""
echo -e "${BOLD}  ╔═══════════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}  ║     🔧 fix-all — Complete System Recovery        ║${NC}"
echo -e "${BOLD}  ╚═══════════════════════════════════════════════════╝${NC}"
echo -e "  Mode: ${CYAN}${MODE}${NC}  |  $(date '+%Y-%m-%d %H:%M:%S')"
echo ""

# ╔═══════════════════════════════════════════════════════════════════╗
# ║  SECTION 1: CRASH RECOVERY (run after every bad sleep/reboot)   ║
# ╚═══════════════════════════════════════════════════════════════════╝

recover_system() {
  header "1/6 — DPKG & PACKAGE REPAIR"

  # 1a. Fix dpkg interrupted state
  if [[ -d /var/lib/dpkg/updates ]] && ls /var/lib/dpkg/updates/[0-9]* &>/dev/null; then
    warn "dpkg has pending updates (interrupted install detected)"
    if ! $DRY_RUN; then
      dpkg --configure -a 2>&1 && log "dpkg --configure -a completed" || err "dpkg configure failed"
    else
      info "[dry-run] Would run: dpkg --configure -a"
    fi
  else
    log "dpkg state is clean"
  fi

  # 1b. Fix broken apt packages
  info "Fixing broken apt packages..."
  if ! $DRY_RUN; then
    apt-get -f install -y 2>&1 | tail -3 && log "apt-get -f install completed" || warn "apt fix-broken had issues"
  else
    info "[dry-run] Would run: apt-get -f install -y"
  fi

  # 1c. Force reconfigure any half-configured packages
  HALF_CONFIGURED=$(dpkg -l 2>/dev/null | awk '/^iU|^iF|^iH|^iW/ {print $2}')
  if [[ -n "$HALF_CONFIGURED" ]]; then
    warn "Half-configured packages found:"
    echo "$HALF_CONFIGURED" | while read pkg; do
      warn "  - $pkg"
      if ! $DRY_RUN; then
        dpkg --configure "$pkg" 2>&1 || true
      fi
    done
    log "Reconfigured half-installed packages"
  else
    log "No half-configured packages"
  fi

  # 1d. Remove stale dpkg/apt locks (from crash)
  for lockfile in /var/lib/dpkg/lock /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/cache/apt/archives/lock; do
    if [[ -f "$lockfile" ]] && ! fuser "$lockfile" &>/dev/null; then
      if ! $DRY_RUN; then
        rm -f "$lockfile" 2>/dev/null && log "Removed stale lock: $lockfile" || true
      else
        info "[dry-run] Would remove stale lock: $lockfile"
      fi
    fi
  done

  header "2/6 — BUN REPAIR"

  BUN_BIN="$HOME/.bun/bin/bun"
  if [[ ! -x "$BUN_BIN" ]]; then
    warn "bun binary missing or not executable at $BUN_BIN"
    if ! $DRY_RUN; then
      info "Reinstalling bun..."
      curl -fsSL https://bun.sh/install | bash 2>&1 | tail -3
      log "bun reinstalled"
    else
      info "[dry-run] Would reinstall bun"
    fi
  else
    # Test if bun binary is corrupted (segfault on --version)
    if ! timeout 5 "$BUN_BIN" --version &>/dev/null; then
      warn "bun binary exists but is corrupted/segfaults"
      if ! $DRY_RUN; then
        info "Reinstalling bun..."
        rm -f "$BUN_BIN"
        curl -fsSL https://bun.sh/install | bash 2>&1 | tail -3
        log "bun reinstalled"
      else
        info "[dry-run] Would reinstall bun"
      fi
    else
      BUN_VER=$("$BUN_BIN" --version 2>/dev/null)
      log "bun is healthy (v$BUN_VER)"
    fi
  fi

  # Clear bun cache (can get corrupted on crash)
  if [[ -d "$HOME/.bun/install/cache" ]]; then
    if ! $DRY_RUN; then
      rm -rf "$HOME/.bun/install/cache"/* 2>/dev/null
      log "bun cache cleared"
    else
      info "[dry-run] Would clear bun cache"
    fi
  fi

  header "3/6 — SHARED MEMORY & SEMAPHORE CLEANUP"

  # After a crash, shared memory segments and semaphores can get stuck
  STALE_SHM=$(ipcs -m 2>/dev/null | awk -v user="$(logname 2>/dev/null || echo $SUDO_USER)" '$3==user {print $2}')
  if [[ -n "$STALE_SHM" ]]; then
    warn "Found stale shared memory segments"
    echo "$STALE_SHM" | while read shmid; do
      if ! $DRY_RUN; then
        ipcrm -m "$shmid" 2>/dev/null && log "Removed shm $shmid" || true
      fi
    done
  else
    log "No stale shared memory"
  fi

  STALE_SEM=$(ipcs -s 2>/dev/null | awk -v user="$(logname 2>/dev/null || echo $SUDO_USER)" '$3==user {print $2}')
  if [[ -n "$STALE_SEM" ]]; then
    warn "Found stale semaphores"
    echo "$STALE_SEM" | while read semid; do
      if ! $DRY_RUN; then
        ipcrm -s "$semid" 2>/dev/null && log "Removed sem $semid" || true
      fi
    done
  else
    log "No stale semaphores"
  fi

  header "4/6 — RAM RECOVERY & CACHE FLUSH"

  info "Before cleanup:"
  free -h | head -2 | sed 's/^/    /'
  echo ""

  if ! $DRY_RUN; then
    # Sync all dirty pages to disk
    sync
    log "Filesystem synced"

    # Drop page cache, dentries, inodes
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null && log "Page cache dropped" || warn "Could not drop caches"

    # Clear systemd journal (can use GBs after crashes with repeated logs)
    journalctl --vacuum-size=50M 2>/dev/null && log "Journal vacuumed to 50MB" || true

    # Kill any orphaned/crashed app processes still holding memory
    # Look for processes in D (uninterruptible sleep) or T (stopped) state
    STUCK_PROCS=$(ps aux | awk '$8 ~ /^[DT]/ && $1 != "root" {print $2, $11}')
    if [[ -n "$STUCK_PROCS" ]]; then
      warn "Stuck processes (D/T state):"
      echo "$STUCK_PROCS" | while read pid cmd; do
        warn "  PID $pid: $cmd"
        kill -9 "$pid" 2>/dev/null && log "  Killed $pid" || true
      done
    fi
  fi

  # Clear /tmp junk from crashed processes
  if ! $DRY_RUN; then
    find /tmp -maxdepth 1 -user "${SUDO_USER:-$USER}" -name "*.lock" -delete 2>/dev/null
    find /tmp -maxdepth 1 -user "${SUDO_USER:-$USER}" -name "*.pid" -delete 2>/dev/null
    rm -rf /tmp/node-compile-cache 2>/dev/null
    rm -rf /tmp/.org.chromium.* 2>/dev/null
    log "Cleaned stale /tmp files"
  fi

  echo ""
  info "After cleanup:"
  free -h | head -2 | sed 's/^/    /'

  header "5/6 — SWAP RESET"

  SWAP_USED=$(free | awk '/Swap:/ {print $3}')
  if [[ $SWAP_USED -gt 0 ]]; then
    SWAP_MB=$((SWAP_USED / 1024))
    warn "Swap has ${SWAP_MB}MB of stale data from pre-crash"
    if ! $DRY_RUN; then
      info "Cycling swap (off → on)..."
      swapoff -a 2>&1 && swapon -a 2>&1 && log "Swap cycled — clean" || warn "Swap cycle failed (low memory?)"
    else
      info "[dry-run] Would cycle swap"
    fi
  else
    log "Swap is clean"
  fi

  header "6/6 — FILESYSTEM INTEGRITY"

  # Check for errors flagged by kernel
  FS_ERRORS=$(dmesg 2>/dev/null | grep -ic "EXT4-fs error\|I/O error\|filesystem error" || true)
  if [[ $FS_ERRORS -gt 0 ]]; then
    err "Detected $FS_ERRORS filesystem errors in dmesg!"
    err "Consider running: sudo fsck -f /dev/sdbX  (after unmounting or from recovery)"
  else
    log "No filesystem errors detected"
  fi
}


# ╔═══════════════════════════════════════════════════════════════════╗
# ║  SECTION 2: PERMANENT FIX (run once to prevent future crashes)  ║
# ╚═══════════════════════════════════════════════════════════════════╝

apply_permanent_fix() {
  header "PERMANENT FIX — NVIDIA SLEEP/RESUME"

  info "Root Cause Analysis:"
  info "  1. NVIDIA GPU doesn't save VRAM on sleep → corrupted memory on resume"
  info "  2. NVIDIA suspend/resume systemd services are DISABLED"
  info "  3. GRUB resume= parameter not reaching kernel (boot mismatch)"
  info "  4. GRUB cmdline has typo: 'achi' should be 'ahci', 'ir' is truncated"
  echo ""

  # Fix 2a: Enable NVIDIA power management services
  hr
  info "Enabling NVIDIA suspend/resume services..."
  if ! $DRY_RUN; then
    systemctl enable nvidia-suspend.service 2>&1 && log "nvidia-suspend enabled" || warn "Failed"
    systemctl enable nvidia-resume.service  2>&1 && log "nvidia-resume enabled"  || warn "Failed"
    systemctl enable nvidia-hibernate.service 2>&1 && log "nvidia-hibernate enabled" || warn "Failed"
    systemctl enable nvidia-persistenced.service 2>&1 && log "nvidia-persistenced enabled" || warn "Failed"
  else
    info "[dry-run] Would enable nvidia-{suspend,resume,hibernate,persistenced}.service"
  fi

  # Fix 2b: Enable PreserveVideoMemoryAllocations
  hr
  info "Enabling NVIDIA VRAM preservation across sleep..."

  NVIDIA_CONF=$(ls /etc/modprobe.d/nvidia*.conf 2>/dev/null | head -1)
  if [[ -n "$NVIDIA_CONF" ]]; then
    if ! $DRY_RUN; then
      # Uncomment if commented, or add if missing
      if grep -q "#.*NVreg_PreserveVideoMemoryAllocations" "$NVIDIA_CONF"; then
        sed -i 's/#\s*options nvidia-current NVreg_PreserveVideoMemoryAllocations=1/options nvidia-current NVreg_PreserveVideoMemoryAllocations=1/' "$NVIDIA_CONF"
        log "Uncommented NVreg_PreserveVideoMemoryAllocations=1"
      elif ! grep -q "NVreg_PreserveVideoMemoryAllocations=1" "$NVIDIA_CONF"; then
        echo "options nvidia-current NVreg_PreserveVideoMemoryAllocations=1" >> "$NVIDIA_CONF"
        log "Added NVreg_PreserveVideoMemoryAllocations=1"
      else
        log "NVreg_PreserveVideoMemoryAllocations=1 already active"
      fi

      # Also enable S0ix power management
      if grep -q "#.*NVreg_EnableS0ixPowerManagement" "$NVIDIA_CONF"; then
        sed -i 's/#\s*options nvidia-current NVreg_EnableS0ixPowerManagement=1/options nvidia-current NVreg_EnableS0ixPowerManagement=1/' "$NVIDIA_CONF"
        log "Uncommented NVreg_EnableS0ixPowerManagement=1"
      elif ! grep -q "NVreg_EnableS0ixPowerManagement=1" "$NVIDIA_CONF"; then
        echo "options nvidia-current NVreg_EnableS0ixPowerManagement=1" >> "$NVIDIA_CONF"
        log "Added NVreg_EnableS0ixPowerManagement=1"
      else
        log "NVreg_EnableS0ixPowerManagement=1 already active"
      fi
    else
      info "[dry-run] Would enable NVreg_PreserveVideoMemoryAllocations=1 in $NVIDIA_CONF"
      info "[dry-run] Would enable NVreg_EnableS0ixPowerManagement=1 in $NVIDIA_CONF"
    fi
  else
    warn "No nvidia modprobe config found — creating one"
    if ! $DRY_RUN; then
      cat > /etc/modprobe.d/nvidia-power.conf << 'NEOF'
options nvidia-current NVreg_PreserveVideoMemoryAllocations=1
options nvidia-current NVreg_EnableS0ixPowerManagement=1
NEOF
      log "Created /etc/modprobe.d/nvidia-power.conf"
    fi
  fi

  # Fix 2c: Fix GRUB configuration
  hr
  info "Fixing GRUB boot parameters..."

  GRUB_FILE="/etc/default/grub"
  CURRENT_LINE=$(grep "^GRUB_CMDLINE_LINUX_DEFAULT" "$GRUB_FILE" 2>/dev/null)

  if [[ -n "$CURRENT_LINE" ]]; then
    info "Current:  $CURRENT_LINE"
    # Fix: 'achi' → 'ahci', remove truncated 'ir', add nvidia drm modeset
    FIXED_LINE='GRUB_CMDLINE_LINUX_DEFAULT="quiet resume=UUID=01f247d0-f12f-4d4c-9b47-2ea23d5d6a5b pcie_aspm=off ahci.mobile_lpm_policy=1 nvidia-drm.modeset=1 nvidia-drm.fbdev=1 ibt=off"'
    info "Fixed:    $FIXED_LINE"
    echo ""

    if confirm; then
      if ! $DRY_RUN; then
        # Backup original
        cp "$GRUB_FILE" "${GRUB_FILE}.bak.$(date +%Y%m%d%H%M%S)"
        log "Backed up $GRUB_FILE"

        sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|$FIXED_LINE|" "$GRUB_FILE"
        log "GRUB config updated"

        # Regenerate grub
        update-grub 2>&1 | tail -5
        log "GRUB regenerated (update-grub)"
      fi
    fi
  fi

  # Fix 2d: Rebuild initramfs with correct resume config
  hr
  info "Updating initramfs with resume support..."
  if ! $DRY_RUN; then
    # Ensure resume is in initramfs config
    if [[ -f /etc/initramfs-tools/conf.d/resume ]]; then
      log "Resume config exists: $(cat /etc/initramfs-tools/conf.d/resume)"
    else
      echo "RESUME=UUID=01f247d0-f12f-4d4c-9b47-2ea23d5d6a5b" > /etc/initramfs-tools/conf.d/resume
      log "Created resume config"
    fi

    update-initramfs -u -k all 2>&1 | tail -5
    log "initramfs rebuilt"
  else
    info "[dry-run] Would rebuild initramfs"
  fi

  # Fix 2e: Create systemd sleep hooks for graceful app shutdown
  hr
  info "Installing pre-sleep hook to gracefully stop heavy apps..."
  if ! $DRY_RUN; then
    mkdir -p /usr/lib/systemd/system-sleep/
    cat > /usr/lib/systemd/system-sleep/fix-all-hook.sh << 'HOOKEOF'
#!/bin/bash
# Pre-sleep: gracefully stop heavy processes to prevent VRAM/RAM corruption
# Post-resume: reset GPU state

case "$1/$2" in
  pre/*)
    logger "fix-all-hook: Pre-sleep cleanup starting"

    # Sync filesystems before sleep
    sync

    # Ask Electron apps to save state (graceful SIGTERM, not SIGKILL)
    # They get 5 seconds to save before the kernel suspends
    for proc in antigravity chrome chromium; do
      pkill -SIGUSR1 "$proc" 2>/dev/null || true  # Trigger save-state if supported
    done

    # Flush dirty pages
    echo 1 > /proc/sys/vm/drop_caches 2>/dev/null || true

    logger "fix-all-hook: Pre-sleep cleanup done"
    ;;

  post/*)
    logger "fix-all-hook: Post-resume recovery starting"

    # Give NVIDIA driver time to reinitialize
    sleep 2

    # Reset GPU if it's in a bad state
    if ! nvidia-smi &>/dev/null; then
      logger "fix-all-hook: NVIDIA GPU not responding, attempting reset"
      modprobe -r nvidia_uvm 2>/dev/null || true
      modprobe nvidia_uvm 2>/dev/null || true
    fi

    # Clear any stale lock files
    rm -f /tmp/.X*-lock 2>/dev/null || true

    logger "fix-all-hook: Post-resume recovery done"
    ;;
esac
HOOKEOF
    chmod +x /usr/lib/systemd/system-sleep/fix-all-hook.sh
    log "Sleep hook installed at /usr/lib/systemd/system-sleep/fix-all-hook.sh"
  else
    info "[dry-run] Would install systemd sleep hook"
  fi

  # Fix 2f: Set vm.swappiness to reduce swap thrashing
  hr
  info "Tuning VM parameters for stability..."
  if ! $DRY_RUN; then
    # Lower swappiness (default 60 → 10) — less eager to swap, reduces post-resume corruption
    CURRENT_SWAPPINESS=$(cat /proc/sys/vm/swappiness)
    if [[ $CURRENT_SWAPPINESS -gt 20 ]]; then
      echo "vm.swappiness=10" > /etc/sysctl.d/99-fix-all-swappiness.conf
      sysctl -w vm.swappiness=10 >/dev/null
      log "Swappiness: $CURRENT_SWAPPINESS → 10"
    else
      log "Swappiness already low ($CURRENT_SWAPPINESS)"
    fi

    # Increase dirty ratio for fewer write-backs during sleep
    echo "vm.dirty_background_ratio=5" >> /etc/sysctl.d/99-fix-all-swappiness.conf
    echo "vm.dirty_ratio=10" >> /etc/sysctl.d/99-fix-all-swappiness.conf
    sysctl -p /etc/sysctl.d/99-fix-all-swappiness.conf >/dev/null 2>&1
    log "VM dirty ratios configured"
  else
    info "[dry-run] Would set vm.swappiness=10"
  fi

  # Fix 2g: Fix bluetooth autosuspend rule (seen causing errors in logs)
  hr
  if [[ -f /etc/udev/rules.d/50-bluetooth-power.rules ]]; then
    info "Fixing bluetooth udev rule (removes autosuspend errors)..."
    if ! $DRY_RUN; then
      # The rule references power/autosuspend which doesn't exist on this device
      # Change to power/control only
      sed -i 's/ATTR{power\/autosuspend}="-1"//' /etc/udev/rules.d/50-bluetooth-power.rules
      log "Fixed bluetooth udev rule"
    fi
  fi
}


# ╔══════════════════════════════════════════════════════════════════╗
# ║  SECTION 3: FINAL SUMMARY                                      ║
# ╚══════════════════════════════════════════════════════════════════╝

show_summary() {
  header "FINAL STATUS"

  free -h | head -2 | sed 's/^/    /'
  echo ""

  USED_PCT=$(free | awk '/Mem:/ {printf "%.0f", $3/$2*100}')
  PROCS=$(ps aux | wc -l)
  info "RAM: ${USED_PCT}% used  |  Processes: $PROCS"
  echo ""

  # Check NVIDIA services
  for svc in nvidia-suspend nvidia-resume nvidia-hibernate; do
    STATUS=$(systemctl is-enabled "$svc" 2>/dev/null || echo "unknown")
    if [[ "$STATUS" == "enabled" ]]; then
      log "$svc: $STATUS"
    else
      warn "$svc: $STATUS"
    fi
  done
  echo ""

  # Check NVreg
  PRESERVE=$(cat /proc/driver/nvidia/params 2>/dev/null | grep PreserveVideoMemoryAllocations | awk '{print $2}')
  if [[ "$PRESERVE" == "1" ]]; then
    log "NVreg_PreserveVideoMemoryAllocations: ACTIVE"
  else
    warn "NVreg_PreserveVideoMemoryAllocations: NOT ACTIVE (requires reboot)"
  fi
  echo ""

  hr
  echo ""
  echo -e "${BOLD}  ✅ fix-all complete${NC}"
  echo ""
  if ! $RECOVER_ONLY; then
    echo -e "  ${YELLOW}⚠  REBOOT REQUIRED for permanent fixes to take effect${NC}"
    echo -e "  ${CYAN}Run: sudo reboot${NC}"
  fi
  echo ""
  echo -e "  ${CYAN}Quick reference:${NC}"
  echo "  • After crash:    sudo fix-all --recover"
  echo "  • Full repair:    sudo fix-all"
  echo "  • Preview only:   fix-all --dry-run"
  echo ""
  hr
}


# ── Main ─────────────────────────────────────────────────────────────

if $PERMANENT_ONLY; then
  need_root
  apply_permanent_fix
  show_summary
elif $RECOVER_ONLY; then
  need_root
  recover_system
  show_summary
else
  need_root
  recover_system
  apply_permanent_fix
  show_summary
fi
