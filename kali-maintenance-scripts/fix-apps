#!/usr/bin/env bash
#═══════════════════════════════════════════════════════════════════════
#  fix-apps — Emergency RAM & App Recovery Script
#  Usage:  fix-apps           (interactive)
#          fix-apps --force   (no prompts)
#          fix-apps --dry-run (preview only)
#═══════════════════════════════════════════════════════════════════════
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

DRY_RUN=false; FORCE=false
for arg in "$@"; do
  case "$arg" in
    --force|-f)   FORCE=true ;;
    --dry-run|-n) DRY_RUN=true ;;
  esac
done

log()  { echo -e "  ${GREEN}[✓]${NC} $*"; }
warn() { echo -e "  ${YELLOW}[!]${NC} $*"; }
info() { echo -e "  ${CYAN}[i]${NC} $*"; }
hr()   { echo -e "${BOLD}  ───────────────────────────────────────────────${NC}"; }
run()  { if ! $DRY_RUN; then eval "$@" 2>/dev/null || true; else info "[dry-run] $*"; fi; }

hr
echo -e "${BOLD}  🔧 fix-apps — RAM Cleanup & App Recovery${NC}"
echo -e "  $(date '+%Y-%m-%d %H:%M:%S')"
hr
echo ""

# ── 1. Memory snapshot ────────────────────────────────────────────────
info "Memory before:"
free -h | head -2 | sed 's/^/    /'
echo ""

USED_PCT=$(free | awk '/Mem:/ {printf "%.0f", $3/$2*100}')
CACHE_MB=$(awk '/^Cached:/ {printf "%.0f", $2/1024}' /proc/meminfo)
info "RAM: ${USED_PCT}% used  |  Page cache: ${CACHE_MB}MB reclaimable"
echo ""

# ── 2. Top memory hogs ───────────────────────────────────────────────
hr
info "Top memory consumers (>50MB):"
echo ""
printf "  %-10s %6s %9s  %s\n" "USER" "%MEM" "RSS(MB)" "COMMAND"
ps aux --sort=-%mem | awk '$6/1024 > 50 && NR > 1 {
  cmd=$11
  # shorten long paths
  n=split(cmd,a,"/"); cmd=a[n]
  # truncate
  if(length(cmd)>45) cmd=substr(cmd,1,42)"..."
  printf "  %-10s %5.1f%% %8.1f  %s\n", $1, $4, $6/1024, cmd
}' | head -30
echo ""

# ── 3. Zombie check ──────────────────────────────────────────────────
hr
info "Checking for zombie processes..."
ZOMBIES=$(ps aux | awk '$8 ~ /^Z/ {print $2}' | wc -l)
if [[ $ZOMBIES -gt 0 ]]; then
  warn "Found $ZOMBIES zombie(s) — sending SIGCHLD to parents"
  ps aux | awk '$8 ~ /^Z/ {print $2}' | while read zpid; do
    ppid=$(ps -o ppid= -p "$zpid" 2>/dev/null | tr -d ' ')
    [[ -n "$ppid" && "$ppid" != "1" ]] && run "kill -SIGCHLD $ppid"
  done
else
  log "No zombie processes"
fi
echo ""

# ── 4. Drop page cache ────────────────────────────────────────────────
hr
info "Dropping filesystem caches (${CACHE_MB}MB)..."
if ! $DRY_RUN; then
  sync
  if sudo -n sh -c 'echo 3 > /proc/sys/vm/drop_caches' 2>/dev/null; then
    log "Page cache dropped"
  else
    warn "Needs sudo — run: sudo sh -c 'sync; echo 3 > /proc/sys/vm/drop_caches'"
  fi
else
  info "[dry-run] Would sync + drop page caches"
fi
echo ""

# ── 5. App cache cleanup (with timeouts to prevent hanging) ──────────
hr
info "Clearing application caches..."

# npm cache (timeout 15s to avoid hanging)
if command -v npm &>/dev/null; then
  if ! $DRY_RUN; then
    timeout 15 npm cache clean --force 2>/dev/null && log "npm cache cleared" || warn "npm cache clean timed out (safe to ignore)"
  else
    info "[dry-run] npm cache clean --force"
  fi
fi

# Node compile cache
if [[ -d /tmp/node-compile-cache ]]; then
  run "rm -rf /tmp/node-compile-cache"
  log "Node compile cache cleared"
fi

# pip cache
if command -v pip3 &>/dev/null; then
  if ! $DRY_RUN; then
    timeout 10 pip3 cache purge 2>/dev/null && log "pip cache cleared" || true
  else
    info "[dry-run] pip3 cache purge"
  fi
fi

# uv cache
if command -v uv &>/dev/null; then
  if ! $DRY_RUN; then
    timeout 10 uv cache clean 2>/dev/null && log "uv cache cleared" || true
  else
    info "[dry-run] uv cache clean"
  fi
fi

# bun cache
if [[ -d "$HOME/.bun/install/cache" ]]; then
  run "rm -rf '$HOME/.bun/install/cache'/*"
  log "bun cache cleared"
fi

# Python __pycache__
PYCOUNT=$(find "$HOME/.gemini/antigravity/scratch" -name "__pycache__" -type d 2>/dev/null | wc -l)
if [[ $PYCOUNT -gt 0 ]]; then
  run "find '$HOME/.gemini/antigravity/scratch' -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null"
  log "Cleared $PYCOUNT __pycache__ dirs"
fi
echo ""

# ── 6. Stale /tmp files ──────────────────────────────────────────────
hr
info "Cleaning stale /tmp files (>7 days old)..."
if ! $DRY_RUN; then
  COUNT=$(find /tmp -maxdepth 1 -user "$USER" -mtime +7 2>/dev/null | wc -l)
  if [[ $COUNT -gt 0 ]]; then
    find /tmp -maxdepth 1 -user "$USER" -mtime +7 -exec rm -rf {} + 2>/dev/null || true
    log "Removed $COUNT stale /tmp entries"
  else
    log "No stale /tmp files"
  fi
else
  info "[dry-run] Would clean /tmp files >7 days old"
fi
echo ""

# ── 7. Swap status ────────────────────────────────────────────────────
hr
SWAP_USED=$(free | awk '/Swap:/ {print $3}')
if [[ $SWAP_USED -gt 1024 ]]; then
  SWAP_MB=$((SWAP_USED / 1024))
  warn "Swap: ${SWAP_MB}MB in use — run 'sudo swapoff -a && sudo swapon -a' to clear"
else
  log "Swap clean (${SWAP_USED}KB)"
fi
echo ""

# ── 8. Result ─────────────────────────────────────────────────────────
hr
info "Memory after:"
free -h | head -2 | sed 's/^/    /'
echo ""

NEW_PCT=$(free | awk '/Mem:/ {printf "%.0f", $3/$2*100}')
SAVED=$((USED_PCT - NEW_PCT))
if [[ $SAVED -gt 0 ]]; then
  log "RAM: ${USED_PCT}% → ${NEW_PCT}% (freed ~${SAVED}%)"
else
  log "RAM: ${NEW_PCT}%  (page cache will repopulate gradually — that's normal)"
fi

echo ""
hr
echo -e "${BOLD}  ✅ fix-apps complete${NC}"
echo ""
echo -e "  ${CYAN}Tips:${NC}"
echo "  • Disable unused MCP plugins in Antigravity → Plugins (~100-200MB each)"
echo "  • Chrome has 15+ renderer processes open right now"
echo "  • For full crash recovery: sudo fix-all --recover"
echo ""
hr
